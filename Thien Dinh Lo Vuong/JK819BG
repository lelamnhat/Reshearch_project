class Rectangle:
    def __init__(self, w, h):
        self.w = w
        self.h = h

    def area(self):
        return self.w * self.h


class Circle:
    def __init__(self, r):
        self.r = r

    def area(self):
        return 3.14 * self.r * self.r


def print_area(shape):
    print(shape.area())


shapes = [
    Rectangle(5, 10),
    Circle(3)
]

for shape in shapes:
    print_area(shape)