def add(a, b):
    if isinstance(a, (int, float)) and isinstance(b, (int, float)):
        return a + b
    elif isinstance(a, str) and isinstance(b, str):
        return a + b
    elif isinstance(a, list) and isinstance(b, list):
        return a + b
    else:
        return "Không hỗ trợ kiểu dữ liệu này"


print(add(5, 3))
print(add("Hello ", "World"))
print(add([1, 2], [3, 4]))